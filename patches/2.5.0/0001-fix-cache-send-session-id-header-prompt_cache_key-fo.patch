From f5e7dec8749b43992dbd557bc2747e617bdf8303 Mon Sep 17 00:00:00 2001
From: hark <hark@local>
Date: Wed, 11 Nov 2026 03:23:56 +0000
Subject: [PATCH] fix(cache): send session-id header = prompt_cache_key for
 Codex backend cache affinity

codex-rs build_session_headers sends session-id (root session: same value as
prompt_cache_key). Without it the backend ignores the body key for affinity
(openai-oauth #46: 0% -> 99% cached on a 19k prefix). Test + mutant check.
typecheck 0; vitest 17 files / 301 tests pass.
---
 lib/adapter.js             |  4 ++++
 lib/adapter.js.map         |  2 +-
 lib/serialize.d.ts         |  3 +++
 lib/serialize.js           |  3 +++
 lib/serialize.js.map       |  2 +-
 src/adapter.ts             |  4 ++++
 src/serialize.ts           |  3 +++
 tests/prompt-cache.test.ts | 18 ++++++++++++++++++
 8 files changed, 37 insertions(+), 2 deletions(-)

diff --git a/lib/adapter.js b/lib/adapter.js
index 283353b..f9effbc 100644
--- a/lib/adapter.js
+++ b/lib/adapter.js
@@ -261,6 +261,10 @@ export class ChatGptSiwcAdapter extends LlmAdapter {
                     authorization: `Bearer ${auth.accessToken}`,
                     'content-type': 'application/json',
                     ...attributionHeaders(),
+                    // The Codex backend pins prompt-cache affinity on the session-id header,
+                    // not on prompt_cache_key alone (codex-rs build_session_headers). Codex
+                    // sends the same value as the cache key for a root session.
+                    ...(body.prompt_cache_key !== undefined ? { 'session-id': body.prompt_cache_key } : {}),
                 },
                 body: JSON.stringify(body),
                 signal: options.signal,
diff --git a/lib/adapter.js.map b/lib/adapter.js.map
index 90f78c0..faf70eb 100644
--- a/lib/adapter.js.map
+++ b/lib/adapter.js.map
@@ -1 +1 @@
