index 246a241..849b461 100644
--- a/src/adapter.ts
+++ b/src/adapter.ts
@@ -358,6 +358,10 @@ export class ChatGptSiwcAdapter extends LlmAdapter {
           authorization: `Bearer ${auth.accessToken}`,
           'content-type': 'application/json',
           ...attributionHeaders(),
+          // The Codex backend pins prompt-cache affinity on the session-id header,
+          // not on prompt_cache_key alone (codex-rs build_session_headers). Codex
+          // sends the same value as the cache key for a root session.
+          ...(body.prompt_cache_key !== undefined ? { 'session-id': body.prompt_cache_key } : {}),
         },
         body: JSON.stringify(body),
         signal: options.signal,
diff --git a/src/serialize.ts b/src/serialize.ts
index 28d4176..928dc12 100644
--- a/src/serialize.ts
+++ b/src/serialize.ts
@@ -17,6 +17,9 @@
  * Prompt caching (0.2.1-rc.5):
  * - `prompt_cache_key` = the harness session id (hashed when longer than
  *   64 chars), so every turn of one session routes to the same cache.
+ * - The adapter also sends that value as the `session-id` request header:
+ *   the Codex backend derives cache affinity from the header, and the body
+ *   key alone measured ~0% cache hits (openai-oauth #46).
  * - Only the LEADING system messages become `instructions`. A later system
  *   message (DSH sends one when the prompt changes, because the adapter
  *   declares `systemPromptUpdate: 'in-history'`) becomes a developer item
